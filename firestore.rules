rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().data.role
        : null;
    }

    function isAdmin() {
      return role() in ['Super Admin', 'Admin'];
    }

    function isSupervisor() {
      return role() == 'Supervisor';
    }

    function isFinance() {
      return role() == 'Finance Officer';
    }

    function ownUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function assignedVehicle(vehicleId) {
      return signedIn() && vehicleId in userDoc().data.assignedVehicleIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin() || ownUserDoc(userId);
      allow update: if isAdmin() || ownUserDoc(userId);
      allow delete: if isAdmin();
    }

    match /agents/{agentId},
          /drivers/{driverId},
          /markets/{marketId},
          /streets/{streetId},
          /customers/{customerId},
          /routes/{routeId},
          /alerts/{alertId},
          /tasks/{taskId},
          /reports/{reportId},
          /maintenance_logs/{logId},
          /commissions/{commissionId},
          /expenses/{expenseId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isSupervisor() || isFinance();
    }

    match /attendance/{attendanceId},
          /location_logs/{logId},
          /visits/{visitId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isSupervisor() || request.resource.data.userId == request.auth.uid || request.resource.data.agentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isSupervisor() || assignedVehicle(vehicleId);
    }

    match /trip_logs/{tripId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isSupervisor() || request.resource.data.driverId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /orders/{orderId},
          /payments/{paymentId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isSupervisor() || isFinance() || request.resource.data.agentId == request.auth.uid;
      allow delete: if isAdmin() || isFinance();
    }
  }
}
